# ===========================================================================
# Unity 6 project — .gitignore
# Place at the repository root (next to Assets/ and ProjectSettings/).
# Rule of thumb: commit Assets/, Packages/, ProjectSettings/.
# Everything generated by the editor is disposable and must never be committed.
# ===========================================================================

# --- Unity generated directories -------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# Unity 6 "Enter Play Mode Options" / Input System temp folder
/[Aa]ssets/.utmp/

# Addressables / StreamingAssets generated bundles
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- Generated solution / project files ------------------------------------
# Regenerated by Unity on every asset refresh; the .slnx/.csproj set is
# IDE-specific and must never be the source of truth.
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
*.VC.VC.opendb

# --- IDE / editor caches ----------------------------------------------------
.vs/
.idea/
.vscode/*.log
.vscode/launch.json.bak

# --- OS junk ----------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- Unity crash / analytics reports ---------------------------------------
sysinfo.txt
crashlytics-build.properties
[Aa]ssets/[Ss]treamingAssets/build_info

# --- Exported builds / packages --------------------------------------------
*.apk
*.aab
*.ipa
*.app
*.unitypackage
*.app.meta
/[Ee]xports/

# --- Screenshots captured by the pi unity_capture tool ----------------------
# These are generated verification artifacts, not source. Remove this rule if
# you want to commit screenshots as project content.
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta

# --- Debug symbol leftovers -------------------------------------------------
*.pdb
*.mdb
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Team .gitignore rules (from coloured-tiles init commit) ---------------
.DS_Store
.env
.env.*
!.env.example
