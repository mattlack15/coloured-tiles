# ===========================================================================
# Unity 6 project — .gitattributes
# 1. Line-ending normalization (Unity Force Text mode needs LF-stable YAML)
# 2. UnityYAMLMerge as the merge driver for Unity YAML assets
# 3. Git LFS for binary asset types
#
# Order matters: later rules win. LFS rules must come last so their
# `-text` attribute overrides the `text eol=lf` normalization above.
# ===========================================================================

# --- Default: let git detect text vs binary, normalize to LF ---------------
* text=auto eol=lf

# --- Unity YAML: always text, always LF, smart-merged ----------------------
# Requires the local config set up by scripts/install-unityyamlmerge.sh
*.meta                text eol=lf merge=unityyamlmerge
*.unity               text eol=lf merge=unityyamlmerge
*.prefab              text eol=lf merge=unityyamlmerge
*.asset               text eol=lf merge=unityyamlmerge
*.mat                 text eol=lf merge=unityyamlmerge
*.anim                text eol=lf merge=unityyamlmerge
*.controller          text eol=lf merge=unityyamlmerge
*.overrideController  text eol=lf merge=unityyamlmerge
*.physicMaterial      text eol=lf merge=unityyamlmerge
*.physicsMaterial2D   text eol=lf merge=unityyamlmerge
*.playable            text eol=lf merge=unityyamlmerge
*.preset              text eol=lf merge=unityyamlmerge
*.mask                text eol=lf merge=unityyamlmerge
*.signal              text eol=lf merge=unityyamlmerge
*.lighting            text eol=lf merge=unityyamlmerge
*.guiskin             text eol=lf merge=unityyamlmerge
*.shadervariants      text eol=lf merge=unityyamlmerge
*.shadergraph         text eol=lf merge=unityyamlmerge
*.shadersubgraph      text eol=lf merge=unityyamlmerge

# --- Project config that must stay diff-able -------------------------------
ProjectSettings/*.asset  text eol=lf
Packages/*.json          text eol=lf
*.asmdef                 text eol=lf
*.asmref                 text eol=lf
*.json                   text eol=lf
*.md                     text eol=lf
*.txt                    text eol=lf
*.yml                    text eol=lf
*.yaml                   text eol=lf

# --- C# / shader / web source ----------------------------------------------
*.cs       text eol=lf
*.shader   text eol=lf
*.cginc    text eol=lf
*.hlsl     text eol=lf
*.glslinc  text eol=lf
*.compute  text eol=lf
*.uss      text eol=lf
*.uxml     text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf

# --- Executables / archives are binary, never diff or merge ----------------
*.bat  text eol=crlf
*.cmd  text eol=crlf

# ===========================================================================
# Git LFS — binary assets
# `filter=lfs diff=lfs merge=lfs -text` = store in LFS, never text-diff,
# never apply line-ending conversion.
# ===========================================================================

